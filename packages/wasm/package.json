{
  "name": "@localmock/wasm",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "WASM engine for LocalMock hot loops - built with wasm-pack from Rust",
  "scripts": {
    "build": "wasm-pack build --target web --out-dir pkg",
    "build:bundler": "wasm-pack build --target bundler --out-dir pkg",
    "clean": "rm -rf pkg target"
  },
  "files": ["pkg"],
  "main": "./pkg/localmock_wasm.js",
  "types": "./pkg/localmock_wasm.d.ts"
}
