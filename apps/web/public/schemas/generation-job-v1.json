{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://localmock.dev/schemas/generation-job-v1.json",
  "title": "LocalMock Generation Job",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "seed", "tables"],
  "properties": {
    "version": { "const": 1 },
    "seed": { "type": ["string", "number"] },
    "generatedAt": { "type": "string", "format": "date-time" },
    "tables": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/table" }
    },
    "chaos": { "$ref": "#/$defs/chaos" },
    "output": {
      "type": "object",
      "additionalProperties": false,
      "required": ["format"],
      "properties": {
        "format": { "enum": ["csv", "json", "jsonl", "sql", "tsv", "xml", "cql", "msw", "typescript"] },
        "dialect": { "enum": ["postgres", "mysql", "sqlite"] },
        "fileName": { "type": "string", "minLength": 1 }
      }
    }
  },
  "$defs": {
    "table": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "rows", "fields"],
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string", "minLength": 1 },
        "rows": { "type": "integer", "minimum": 1, "maximum": 1000000 },
        "fields": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/field" } }
      }
    },
    "field": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "type"],
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string", "minLength": 1 },
        "type": { "type": "string", "minLength": 1 },
        "options": { "type": "object" },
        "unique": { "type": "boolean" },
        "primaryKey": { "type": "boolean" },
        "nullable": { "type": "boolean" },
        "foreignKey": {
          "type": "object",
          "additionalProperties": false,
          "required": ["table", "field"],
          "properties": {
            "table": { "type": "string", "minLength": 1 },
            "field": { "type": "string", "minLength": 1 }
          }
        }
      }
    },
    "chaos": {
      "type": "object",
      "additionalProperties": false,
      "required": ["rate", "types"],
      "properties": {
        "rate": { "type": "number", "minimum": 0, "maximum": 30 },
        "types": {
          "type": "object",
          "additionalProperties": false,
          "required": ["nullInjection", "whitespace", "encoding", "casing", "formatStrip"],
          "properties": {
            "nullInjection": { "type": "boolean" },
            "whitespace": { "type": "boolean" },
            "encoding": { "type": "boolean" },
            "casing": { "type": "boolean" },
            "formatStrip": { "type": "boolean" }
          }
        }
      }
    }
  }
}
