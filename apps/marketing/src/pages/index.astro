---
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
---

<Base title="LocalMock — Generate Unlimited Mock Data Instantly">
  <Header />

  <main>
    <!-- Hero Section -->
    <section class="mx-auto max-w-6xl px-6 py-24 text-center">
      <h1 class="text-4xl font-bold tracking-tight text-text-primary sm:text-5xl">
        Generate <span class="text-accent">unlimited</span> mock data
        <br />directly in your browser.
      </h1>
      <p class="mx-auto mt-6 max-w-2xl text-lg text-text-secondary">
        Paste a schema, get 100,000+ rows of relational data in seconds. 
        No signup. No server. No row limits. Privacy-first, client-side only.
      </p>
      <div class="mt-10 flex items-center justify-center gap-4">
        <a
          href="https://app.localmock.in"
          class="inline-flex h-11 items-center rounded-lg bg-accent px-6 text-base font-medium text-white shadow hover:bg-accent-hover transition-colors"
        >
          Open LocalMock →
        </a>
        <a
          href="https://github.com/Samarth208P/localmock"
          class="inline-flex h-11 items-center rounded-lg border border-border-subtle px-6 text-base font-medium text-text-secondary hover:bg-bg-tertiary hover:text-text-primary transition-colors"
        >
          View on GitHub
        </a>
      </div>
    </section>

    <!-- Features Section -->
    <section class="border-t border-border-subtle py-20">
      <div class="mx-auto max-w-6xl px-6">
        <h2 class="text-center text-2xl font-semibold text-text-primary">
          Everything you need. Nothing you don't.
        </h2>
        <div class="mt-12 grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-3">
          <div class="rounded-lg border border-border-subtle bg-bg-secondary p-6">
            <div class="text-2xl">⚡</div>
            <h3 class="mt-3 text-base font-semibold text-text-primary">Zero-Latency Generation</h3>
            <p class="mt-2 text-sm text-text-secondary">
              Web Workers generate data off-thread. Your UI never freezes, even at 100k+ rows.
            </p>
          </div>
          <div class="rounded-lg border border-border-subtle bg-bg-secondary p-6">
            <div class="text-2xl">🔗</div>
            <h3 class="mt-3 text-base font-semibold text-text-primary">Relational Data (DAG)</h3>
            <p class="mt-2 text-sm text-text-secondary">
              Define parent-child relationships. Foreign keys are guaranteed valid across tables.
            </p>
          </div>
          <div class="rounded-lg border border-border-subtle bg-bg-secondary p-6">
            <div class="text-2xl">🧠</div>
            <h3 class="mt-3 text-base font-semibold text-text-primary">Smart Schema Parsing</h3>
            <p class="mt-2 text-sm text-text-secondary">
              Paste TypeScript, Prisma, or JSON. The parser auto-detects types and assigns generators.
            </p>
          </div>
          <div class="rounded-lg border border-border-subtle bg-bg-secondary p-6">
            <div class="text-2xl">💥</div>
            <h3 class="mt-3 text-base font-semibold text-text-primary">Chaos Engine</h3>
            <p class="mt-2 text-sm text-text-secondary">
              Inject nulls, bad encodings, whitespace, and mixed casing. Stress-test your app.
            </p>
          </div>
          <div class="rounded-lg border border-border-subtle bg-bg-secondary p-6">
            <div class="text-2xl">📦</div>
            <h3 class="mt-3 text-base font-semibold text-text-primary">5 Export Formats</h3>
            <p class="mt-2 text-sm text-text-secondary">
              CSV, JSON, SQL INSERT, MSW handlers, and TypeScript arrays. Ready for your workflow.
            </p>
          </div>
          <div class="rounded-lg border border-border-subtle bg-bg-secondary p-6">
            <div class="text-2xl">🔒</div>
            <h3 class="mt-3 text-base font-semibold text-text-primary">100% Private</h3>
            <p class="mt-2 text-sm text-text-secondary">
              No data leaves your browser. No accounts. No tracking. Your schemas stay yours.
            </p>
          </div>
        </div>
      </div>
    </section>

    <!-- How It Works -->
    <section class="border-t border-border-subtle py-20">
      <div class="mx-auto max-w-4xl px-6 text-center">
        <h2 class="text-2xl font-semibold text-text-primary">Three steps. Three seconds.</h2>
        <div class="mt-12 grid grid-cols-1 gap-8 sm:grid-cols-3">
          <div>
            <div class="mx-auto flex h-10 w-10 items-center justify-center rounded-lg bg-accent-subtle text-accent font-semibold">1</div>
            <h3 class="mt-4 font-medium text-text-primary">Paste your schema</h3>
            <p class="mt-2 text-sm text-text-muted">TypeScript interface, Prisma model, or raw JSON.</p>
          </div>
          <div>
            <div class="mx-auto flex h-10 w-10 items-center justify-center rounded-lg bg-accent-subtle text-accent font-semibold">2</div>
            <h3 class="mt-4 font-medium text-text-primary">Configure & generate</h3>
            <p class="mt-2 text-sm text-text-muted">Set row count, chaos level, and export format.</p>
          </div>
          <div>
            <div class="mx-auto flex h-10 w-10 items-center justify-center rounded-lg bg-accent-subtle text-accent font-semibold">3</div>
            <h3 class="mt-4 font-medium text-text-primary">Download instantly</h3>
            <p class="mt-2 text-sm text-text-muted">Stream to disk. No limits. No waiting.</p>
          </div>
        </div>
      </div>
    </section>

    <!-- CTA -->
    <section class="border-t border-border-subtle py-20 text-center">
      <div class="mx-auto max-w-2xl px-6">
        <h2 class="text-2xl font-semibold text-text-primary">Ready to generate?</h2>
        <p class="mt-4 text-text-secondary">
          No signup required. Open the app and start generating mock data in seconds.
        </p>
        <a
          href="https://app.localmock.in"
          class="mt-8 inline-flex h-11 items-center rounded-lg bg-accent px-6 text-base font-medium text-white shadow hover:bg-accent-hover transition-colors"
        >
          Launch LocalMock →
        </a>
      </div>
    </section>
  </main>

  <Footer />
</Base>
